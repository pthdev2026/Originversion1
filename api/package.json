{
  "name": "origin-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test src/*.test.ts",
    "db:start": "node scripts/db-server.ts",
    "db:migrate": "node scripts/migrate.ts",
    "ingest": "node scripts/ingest.ts",
    "postinstall": "cd node_modules/@embedded-postgres/darwin-arm64 2>/dev/null && node scripts/hydrate-symlinks.js || true"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "embedded-postgres": "^17.10.0-beta.17",
    "hono": "^4.6.0",
    "postgres": "^3.4.9"
  },
  "engines": {
    "node": ">=22.18"
  }
}