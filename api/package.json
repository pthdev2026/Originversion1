{
  "name": "origin-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "UV_THREADPOOL_SIZE=16 node --watch --env-file-if-exists=.env src/main.ts",
    "start": "UV_THREADPOOL_SIZE=16 node --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "db:start": "node scripts/db-server.ts",
    "db:migrate": "node scripts/migrate.ts",
    "ingest": "node scripts/ingest.ts",
    "postinstall": "cd node_modules/@embedded-postgres/darwin-arm64 2>/dev/null && node scripts/hydrate-symlinks.js || true",
    "user:create-admin": "node scripts/create-admin.ts",
    "worker": "UV_THREADPOOL_SIZE=16 node --env-file-if-exists=.env scripts/worker.ts",
    "media:enqueue": "node --env-file-if-exists=.env scripts/enqueue.ts",
    "cdn:check": "node --env-file-if-exists=.env scripts/cdn-check.ts",
    "backup": "node --env-file-if-exists=.env scripts/backup.ts",
    "backup:verify": "node --env-file-if-exists=.env scripts/backup-verify.ts",
    "restore": "node --env-file-if-exists=.env scripts/restore.ts",
    "watchdog": "node --env-file-if-exists=.env scripts/watchdog.ts",
    "load:prepare": "node --env-file-if-exists=.env scripts/load/prepare.ts",
    "load:run": "node --env-file-if-exists=.env scripts/load/run.ts",
    "catalog:import": "node --env-file-if-exists=.env scripts/catalog-import.ts",
    "catalog:export-front": "node scripts/catalog-export-front.ts",
    "mux:check": "node --env-file-if-exists=.env scripts/mux-check.ts",
    "mux:usage": "node --env-file-if-exists=.env scripts/mux-usage.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "pino": "^9.14.0",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=24.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "embedded-postgres": "^17.10.0-beta.17",
    "pino-pretty": "^13.2.0",
    "typescript": "^5.9.3",
    "undici": "^7.30.0"
  }
}
