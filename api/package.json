{
  "name": "origin-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "db:start": "node scripts/db-server.ts",
    "db:migrate": "node scripts/migrate.ts",
    "ingest": "node scripts/ingest.ts",
    "postinstall": "cd node_modules/@embedded-postgres/darwin-arm64 2>/dev/null && node scripts/hydrate-symlinks.js || true",
    "user:create-admin": "node scripts/create-admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "embedded-postgres": "^17.10.0-beta.17",
    "hono": "^4.6.0",
    "pino": "^9.14.0",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=24.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "pino-pretty": "^13.2.0",
    "typescript": "^5.9.3"
  }
}