# Environnement : development | test | production
NODE_ENV=development
# Serveur
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info
# Base de données (en développement : instance locale, voir `npm run db:start`)
# DATABASE_URL=postgres://origin:origin_dev@127.0.0.1:5433/origin
# Stockage : racine contenant videos/, images/, subtitles/ (défaut : ../storage)
# STORAGE_ROOT=/chemin/vers/storage
# Secret de signature des URLs de lecture (32 caractères minimum). OBLIGATOIRE en production.
# MEDIA_SECRET=
# Durée de validité des URLs de lecture, en secondes (60 à 86400)
# MEDIA_TTL_SECONDS=14400
# Origines autorisées (séparées par des virgules). OBLIGATOIRE en production.
# CORS_ORIGINS=https://origin.example
# Rotation du secret : ancien secret, accepté en vérification le temps du changement
# MEDIA_SECRET_PREVIOUS=
# Limitation de débit : requêtes par minute et par adresse IP
# RATE_LIMIT_API_PER_MIN=120
# RATE_LIMIT_MEDIA_PER_MIN=3000
# À "true" UNIQUEMENT derrière un proxy de confiance (lit X-Forwarded-For)
# TRUST_PROXY=false
