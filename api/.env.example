# Port de l'API
PORT=4000
# Dossier des rendus HLS (par défaut : ../storage/hls)
# STORAGE_DIR=/chemin/vers/storage/hls
# Secret de signature des URLs de lecture. Obligatoire en production.
# MEDIA_SECRET=
# Durée de validité des URLs signées, en secondes
# MEDIA_TTL_SECONDS=14400
# Origines autorisées (séparées par des virgules). Par défaut : localhost / 127.0.0.1
# CORS_ORIGINS=https://origin.example
