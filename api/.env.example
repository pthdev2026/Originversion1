# Environnement : development | test | production
NODE_ENV=development
# Serveur
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info
# Base de données (en développement : instance locale, voir `npm run db:start`)
# DATABASE_URL=postgres://origin:origin_dev@127.0.0.1:5433/origin
# Stockage : racine contenant videos/, images/, subtitles/ (défaut : ../storage)
# STORAGE_ROOT=/chemin/vers/storage
# Secret de signature des URLs de lecture (32 caractères minimum). OBLIGATOIRE en production.
# MEDIA_SECRET=
# Durée de validité des URLs de lecture, en secondes (60 à 86400)
# MEDIA_TTL_SECONDS=14400
# Origines autorisées (séparées par des virgules). OBLIGATOIRE en production.
# CORS_ORIGINS=https://origin.example
# Rotation du secret : ancien secret, accepté en vérification le temps du changement
# MEDIA_SECRET_PREVIOUS=
# Limitation de débit : requêtes par minute et par adresse IP
# RATE_LIMIT_API_PER_MIN=120
# RATE_LIMIT_MEDIA_PER_MIN=3000
# À "true" UNIQUEMENT derrière un proxy de confiance (lit X-Forwarded-For)
# TRUST_PROXY=false
# Comptes
# Inscription : open (ouverte à tous) | invite (code d'invitation obligatoire)
# REGISTRATION_MODE=open
# Durée d'une session en jours
# SESSION_TTL_DAYS=30
# "true" : la lecture exige un compte connecté (défaut : ouverte)
# PLAYBACK_REQUIRES_LOGIN=false
# Adresse publique du site (lien de réinitialisation du mot de passe)
# PUBLIC_APP_URL=http://localhost:3210
# Tentatives de connexion / inscription par minute et par IP
# RATE_LIMIT_AUTH_PER_MIN=10
# Encodage : outils et préréglage
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# ENCODE_PRESET=medium
# Taille maximale d'un envoi, en octets (défaut : 60 Go)
# UPLOAD_MAX_BYTES=64424509440
# Diffusion : origin (l'API sert les fichiers) | bunny (CDN Bunny, voir docs/GUIDE-BUNNY.md)
# DELIVERY_MODE=origin
# BUNNY_CDN_URL=https://origin-videos.b-cdn.net
# BUNNY_TOKEN_KEY=
# BUNNY_STORAGE_ZONE=origin-videos
# BUNNY_STORAGE_KEY=
# BUNNY_STORAGE_HOST=storage.bunnycdn.com
# Exploitation (voir docs/EXPLOITATION.md)
# Dossier des sauvegardes : de préférence un AUTRE disque
# BACKUP_DIR=/Volumes/Sauvegardes/origin
# Phrase secrète de chiffrement des sauvegardes (16 caractères min.) — à conserver HORS de la machine
# BACKUP_PASSPHRASE=
# Espace disque minimal avant alerte, en Go
# MIN_FREE_GB=20
# Jeton d'accès à /metrics (24 caractères min.) ; absent = /metrics désactivé
# METRICS_TOKEN=
# Webhook d'alerte (Slack, Discord, ntfy…)
# ALERT_WEBHOOK_URL=
# Ident de marque avant les programmes
# IDENT_POLICY=title            # title (une fois par titre) | season | always | off
# BRAND_IDENT_PLAYBACK_ID=origin-ident
# IDENT_SKIPPABLE_AFTER_SECONDS=2
# Mux (préparation + diffusion vidéo par un service externe) — facultatif. Les deux jetons vont ensemble.
# Les valeurs se saisissent UNIQUEMENT dans ce fichier local (jamais dans le code, jamais dans un message).
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_VIDEO_QUALITY=basic          # basic (encodage gratuit) | plus | premium
# MUX_PLAYBACK_POLICY=public       # public (test) | signed (production : exige une clé de signature)
# MUX_SIGNING_KEY_ID=
# MUX_SIGNING_PRIVATE_KEY=         # base64 du fichier PEM fourni par Mux à la création de la clé de signature
# MUX_NORMALIZE_AUDIO=false        # volume Mux (-24 LUFS) ≠ le nôtre (-16 LUFS) : laisser false pour rester cohérent
# VIDEO_PROVIDER=self              # voie proposée par défaut au back-office : self | mux
# E-mails : log (écrit dans les journaux) | resend (envoi réel)
# MAIL_PROVIDER=log
# MAIL_API_KEY=
# MAIL_FROM=ORIGIN <no-reply@origin.example>
# Double authentification : clé de chiffrement des secrets (32 caractères min.) — à conserver HORS de la machine
# AUTH_ENCRYPTION_KEY=
# "true" : les administrateurs doivent avoir activé la double authentification
# REQUIRE_ADMIN_2FA=false
# Cache serveur du catalogue public, en secondes (0 = aucun)
# CATALOG_CACHE_SECONDS=30
# Conservation des données (jours)
# RETENTION_TELEMETRY_DAYS=180
# RETENTION_AUDIT_DAYS=365
# Volume sonore cible à l'encodage, en LUFS (ou « off »)
# LOUDNESS_TARGET_LUFS=-16
