# Copier en .env.production (jamais versionné) et remplir. Générer un secret : openssl rand -hex 32

# --- Domaines ---
APP_DOMAIN=app.origin.example          # UN SEUL domaine pour le site ET l'API (DNS A/AAAA vers l'IP du serveur)
PUBLIC_APP_URL=https://app.origin.example   # = https://APP_DOMAIN (liens des e-mails ; cette origine est toujours de confiance)
CORS_ORIGINS=https://app.origin.example     # origine unique : pas d'autre origine à autoriser

# --- Secrets ---
POSTGRES_PASSWORD=
MEDIA_SECRET=
BACKUP_PASSPHRASE=                     # 16 caractères minimum ; à CONSERVER ailleurs (gestionnaire de mots de passe)
METRICS_TOKEN=                         # 24 caractères minimum

# --- Double authentification des administrateurs ---
AUTH_ENCRYPTION_KEY=                   # 32 caractères minimum : openssl rand -hex 32 (à conserver ailleurs : sans elle, les 2FA sont inutilisables)
REQUIRE_ADMIN_2FA=true

# --- Application ---
NODE_ENV=production
REGISTRATION_MODE=open                 # open | invite
PLAYBACK_REQUIRES_LOGIN=false
LOG_LEVEL=info
MIN_FREE_GB=20
ALERT_WEBHOOK_URL=                     # Slack / Discord / ntfy (optionnel mais recommandé)

# --- E-mails (réinitialisation de mot de passe) ---
MAIL_PROVIDER=log                      # log (aucun envoi) | resend
MAIL_API_KEY=                          # clé API Resend
MAIL_FROM=ORIGIN <no-reply@origin.example>   # domaine vérifié chez le fournisseur

# --- Performance ---
CATALOG_CACHE_SECONDS=30               # cache serveur du catalogue public

# --- Conservation des données et volume sonore ---
RETENTION_TELEMETRY_DAYS=180
RETENTION_AUDIT_DAYS=365
LOUDNESS_TARGET_LUFS=-16               # off pour désactiver la normalisation du volume

# --- Mux (facultatif) ---
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_VIDEO_QUALITY=basic
MUX_PLAYBACK_POLICY=signed             # en production : signed (liens protégés) + clé de signature ci-dessous
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_NORMALIZE_AUDIO=false
VIDEO_PROVIDER=mux                     # self | mux — décision du propriétaire (30/10/2026) : Mux pour la bêta

# --- Diffusion (voir docs/GUIDE-BUNNY.md) ---
DELIVERY_MODE=origin                   # passer à bunny une fois le CDN configuré
BUNNY_CDN_URL=
BUNNY_TOKEN_KEY=
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
BUNNY_STORAGE_HOST=storage.bunnycdn.com

# --- Limites de débit (par IP et par minute) ---
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_MEDIA_PER_MIN=6000
RATE_LIMIT_AUTH_PER_MIN=10

# --- Formulaire « Nous contacter » (facultatif) ---
SUPPORT_EMAIL=
