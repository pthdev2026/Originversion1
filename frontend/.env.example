# Variables publiques du front (préfixe VITE_). Jamais de secret ici.
# Copier vers .env.local pour le développement.

# URL de l'API ORIGIN. En développement, repli sur http://127.0.0.1:4000 si absente.
# En production, absente = lecture signalée « non configurée » (aucune valeur inventée).
VITE_API_URL=http://127.0.0.1:4000

# Adresse de contact affichée dans les états d'erreur de lecture (optionnelle).
VITE_SUPPORT_EMAIL=

# Prévues par le brief front, pas encore lues par le code (chantier « config-marque ») :
# VITE_SITE_URL=
# VITE_APP_ENV=development
# VITE_ENABLE_INTRO=true

# Aperçu hors connexion : le site s'affiche avec des contenus de DÉMONSTRATION, sans back-end (bandeau permanent).
# Il s'active tout seul quand VITE_API_URL est absente dans un build de production (aperçu hébergé) et, en développement,
# quand l'API est injoignable. Mettre 1 pour le forcer même avec une API configurée. Jamais utilisé en production AVEC une API.
# VITE_OFFLINE_PREVIEW=1
